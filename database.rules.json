{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('role').val() === 'driver'"
      }
    },

    "lot": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
    },

    "slots": { ".read": "auth != null", ".write": false },

    "slotBookings": { ".read": "auth != null", ".write": "auth != null" },

    "bookings": {
      ".indexOn": ["uid", "endSec"],
      ".read": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      "$id": {
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))"
      }
    },

    "parked": {
      ".indexOn": ["uid"],
      ".read": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".write": false
    },

    "sessions": {
      ".indexOn": ["uid", "endSec"],
      ".read": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".write": false
    },

    "gate": {
      "arrival": { ".write": "auth != null" }
    }
  }
}
